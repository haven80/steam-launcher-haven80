#include <winver.h>

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERSION_COMMA@
PRODUCTVERSION @VERSION_COMMA@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Steam Launcher"
      VALUE "ProductName", "Steam Launcher"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "OriginalFilename", "SteamLauncher.exe"
      VALUE "LegalCopyright", "Not affiliated with Valve Corporation"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
